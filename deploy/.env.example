# Kopia tego pliku jako deploy/.env – install.sh tworzy ją automatycznie z losowym hasłem.

# Hasło do bazy danych
POSTGRES_PASSWORD=zmien-mnie

# Port panelu/API na serwerze (HTTP)
NETPULSE_PORT=8000

# Port HTTPS panelu (od 0.62.0) – certyfikat lokalnego CA UplinkView, CA do pobrania w Ustawienia → System
NETPULSE_HTTPS_PORT=8443

# Adresy serwera w certyfikacie HTTPS (nazwy i IP, przecinkami); instalator i `uplinkview update` wpisują
# nazwę i adresy IP serwera, kolejne można dopisać w panelu (Ustawienia → System → HTTPS)
NETPULSE_TLS_NAMES=

# Co ile sekund odpytywać urządzenia
NETPULSE_POLL_INTERVAL=30
# Limit czasu odczytu jednego urządzenia w sekundach; puste = interwał − 5 (co najmniej 20), 0 = bez limitu
# NETPULSE_POLL_TIMEOUT=

# Ile dni trzymać szczegółowe metryki
NETPULSE_RETENTION_DAYS=30
# Po ilu dniach baza kompresuje metryki (mniej miejsca na dysku); 0 = bez kompresji
NETPULSE_COMPRESS_AFTER_DAYS=7
# Sprawdzanie podpisu aktualizacji; off tylko przy własnym źródle aktualizacji (NETPULSE_UPDATE_REPO)
NETPULSE_UPDATE_VERIFY=on

NETPULSE_LOG_LEVEL=INFO
TZ=Europe/Warsaw

# Katalog instalacji na serwerze (ta sama ścieżka jest używana w kontenerze aktualizacji)
NETPULSE_DIR=/opt/uplinkview

# Aktualizacja z panelu (Ustawienia → Aktualizacja): "on" (domyślnie) albo "off" – wtedy panel
# podpowiada tylko polecenie uplinkview update. Token do rozmowy API ↔ usługa aktualizacji
# powstaje sam przy pierwszym starcie (wolumen Docker, nie ten plik).
#NETPULSE_UPDATER=on

# Opcjonalnie: inne źródło aktualizacji (adres repozytorium git) i gałąź
#NETPULSE_UPDATE_REPO=
#NETPULSE_UPDATE_BRANCH=
